# Pchained BNB Smart Chain local configuration example.
# Copy this file to bnbsmartchain.env and replace placeholders with local values.
# Do not commit real API keys, RPC credentials, webhook secrets, or private URLs.

# SECRET ENVIRONMENT VARIABLES
INDEXER_API_KEY=replace-with-indexer-api-key
RPC_API_KEY=replace-with-rpc-api-key

# ENVIRONMENT VARIABLES
INDEXER_URL=https://deep-index.moralis.io/api/v2.2
INDEXER_WS_URL=wss://replace-with-indexer-websocket-url
LOG_LEVEL=info
NETWORK=mainnet
RPC_URL=https://replace-with-rpc-provider-host/bsc
WEBHOOK_URL=https://replace-with-local-or-tunnel-webhook-url
ENVIRONMENT=local
